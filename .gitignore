# === Secrets — never published ===========================================================
.ha_token
# Local Home Assistant address used by the dev checks: never the author's, never in the repo.
.ha_url
esphome/secrets.yaml
secrets.yaml
*.secret.yaml

# === Local environments and build caches =================================================
# The generated esphome/.esphome/ holds the compiled configuration, hence the Wi-Fi
# passwords and the API keys in the clear.
.venv/
.venv-dev/
esphome/.esphome/
build/
*.bin
*.elf
*.map
*.o
*.obj

# === Python ==============================================================================
__pycache__/
*.py[cod]
.pytest_cache/

# === Runtime state and raw measurements (data, not code) =================================
# dev/state/ holds the device-address cache and the watch states: they belong to the machine
# that runs the tools. Only the marker is versioned (git does not track empty directories).
dev/state/*
!dev/state/.gitkeep
dev/logs/*
!dev/logs/.gitkeep

# === Backups and editor leftovers ========================================================
*.bak
*.bak-*
*.orig
*.tmp
*.swp

# === Code review reports (they carry installation details) ===============================
reviews/
