# Copier ce fichier en secrets.yaml et renseigner les valeurs.
# Il est ignoré par git (.gitignore) : les valeurs ne partent jamais dans le dépôt.
wifi_ssid: "MON_SSID"
wifi_password: "MON_MOT_DE_PASSE"
ap_password: "motdepasse-du-point-d-acces-de-secours"
# 32 octets en base64 : `openssl rand -base64 32`
api_key: "CLE_API_BASE64"

# Optionnel : à renseigner seulement si votre réseau l'exige (voir vevor-7in1.yaml).
# use_address: "192.168.1.50"     # adresse fixe de la carte si mDNS ne traverse pas
# wifi_output_power: "8.5dB"      # si votre point d'accès refuse la puissance par défaut
