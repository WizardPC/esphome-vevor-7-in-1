# Copy this file to secrets.yaml, next to the device's YAML, and fill in the values.
# secrets.yaml is git-ignored (.gitignore): its values never reach the repository.
#
# Four keys are required. The names are the ones esphome/vevor-7in1.yaml asks for:
wifi_ssid: "YOUR_SSID"
wifi_password: "YOUR_WIFI_PASSWORD"
# Password of the board's own fallback access point ("Vevor 7-in-1 setup"), used when it cannot
# join your network. 8 characters or more — it is a WPA2 key.
ap_password: "YOUR_FALLBACK_AP_PASSWORD"
# 32 bytes in base64: `openssl rand -base64 32`
# This single key serves both the native API and OTA (the YAML uses `encryption: {}` for OTA):
# changing it re-keys the device, so Home Assistant must be given the new key too.
encryption_key: "YOUR_API_KEY_BASE64"

# Optional keys. Uncomment ONLY what your installation needs, and see the matching comment in
# esphome/vevor-7in1.yaml (a key left commented here must stay commented there too).
#
# board's fixed address, if mDNS does not cross your network (VLAN, another subnet):
# use_address: "192.168.1.50"
#   Symptom without it: the compile succeeds and the upload fails with "no route to host".
#
# No wifi_output_power key here on purpose: that setting lives in esphome/vevor-7in1.yaml
# (`wifi: output_power:`), where the reason for the shipped 8.5 dB is written down.
