# Copy this file to secrets.yaml and fill in the values.
# It is git-ignored (.gitignore): the values never reach the repository.
wifi_ssid: "MON_SSID"
wifi_password: "MON_MOT_DE_PASSE"
ap_password: "motdepasse-du-point-d-acces-de-secours"
# 32 bytes in base64: `openssl rand -base64 32`
api_key: "CLE_API_BASE64"

# Optional: set only if your network requires it (see vevor-7in1.yaml).
# use_address: "192.168.1.50"     # board's fixed address if mDNS does not cross
# wifi_output_power: "8.5dB"      # if your AP refuses the default tx power
