# Gitignore settings for ESPHome
# This is an example and may include too much for your use-case.
# You can modify this file to suit your needs.
/.esphome/
/secrets.yaml
# Local backup of secrets.yaml: never in the repo, not even by accident.
/.secrets-backup
# Per-owner flash files (local configuration, secrets by reference).
/panrahk-flash.yaml
